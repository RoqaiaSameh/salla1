<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#3b111d">
  <title>Glow Theory | لمسة من الجمال لكل يوم</title>
  <link rel="stylesheet" href="assets/css/style.css?v=4"><style>.gt-icon-btn{display:inline-grid;place-items:center;font-size:0}.gt-icon-btn svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.gt-match{background:#fff;padding:78px 0}.gt-match__grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px;align-items:center}.gt-match h2{font:400 clamp(35px,4vw,57px)/1.15 'DM Serif Display','Noto Kufi Arabic',serif;color:var(--wine);margin:14px 0}.gt-match__lead{font-size:12px;color:var(--muted);max-width:330px}.gt-match__choices{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:25px}.gt-match-choice{border:1px solid var(--line);background:#fbf8f5;text-align:right;padding:14px;cursor:pointer;transition:.22s;color:var(--wine)}.gt-match-choice:hover,.gt-match-choice.is-active{background:var(--wine);color:#fff;border-color:var(--wine)}.gt-match-choice strong{display:block;font-size:12px}.gt-match-choice small{font-size:9px;opacity:.75}.gt-match-result{min-height:280px;background:#f2e4dc;display:grid;grid-template-columns:1fr 1fr;overflow:hidden}.gt-match-result img{width:100%;height:280px;object-fit:cover;mix-blend-mode:multiply}.gt-match-result__copy{padding:31px 23px;display:flex;flex-direction:column;justify-content:center}.gt-match-result__copy span{font:600 10px 'DM Sans',sans-serif;color:#9b6873;letter-spacing:.12em}.gt-match-result__copy h3{font:400 32px/1.2 'DM Serif Display','Noto Kufi Arabic',serif;color:var(--wine);margin:10px 0}.gt-match-result__copy p{font-size:10px;color:var(--muted);margin:0 0 18px}.gt-match-result__copy a{font-size:10px;text-decoration:underline;text-underline-offset:5px;color:var(--wine)}@media(max-width:760px){.gt-match{padding:60px 0}.gt-match__grid{grid-template-columns:1fr;gap:28px}.gt-match__choices{margin-top:18px}.gt-match-result{min-height:230px}.gt-match-result img{height:230px}.gt-match-result__copy{padding:18px}.gt-match-result__copy h3{font-size:27px}}</style>
  <style>
    body{background:#f6f1ed}.gt-hero{position:relative;min-height:680px;background:#37131e;isolation:isolate}.gt-hero__grid{display:block;position:relative;min-height:680px}.gt-hero__art{position:absolute;inset:0;min-height:0;z-index:-1}.gt-hero__art:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(47,13,24,.92) 0%,rgba(58,17,29,.61) 42%,rgba(58,17,29,.09) 76%),linear-gradient(0deg,rgba(47,13,24,.24),transparent 45%)}.gt-hero__art img{filter:saturate(.72) contrast(.93) brightness(.92);object-position:center 34%;mix-blend-mode:normal}.gt-hero__shape{display:none}.gt-hero__copy{position:relative;z-index:1;max-width:560px;padding-top:154px;color:#fff}.gt-hero h1{color:#fff}.gt-hero p{color:#eadce0}.gt-hero .gt-eyebrow{color:#e8bdc8}.gt-hero__caption{bottom:28px;left:max(24px,calc((100vw - 1180px)/2));opacity:.8}.gt-values{background:#f6f1ed;border:0}.gt-values>div{min-height:84px}.gt-values span{border-color:#ded2ce;color:#6e3b49}.gt-section{background:#f6f1ed;padding-block:104px}.gt-products{background:#eee4df;padding-block:104px}.gt-story{background:#f6f1ed}.gt-match{background:#eee4df}.gt-collection{background:#ede2dc}.gt-collection--blush{background:#ead9dd}.gt-collection--glow{background:#e9ddd3}.gt-payment{background:linear-gradient(120deg,#32101b,#551a2b)}.gt-payment__methods{background:#eee4df}.gt-faq{background:#f6f1ed}.gt-footer{background:#32101b}.gt-match-result{background:#e7d8d0}.gt-product__image{background:#f8f4f1}@media(max-width:760px){.gt-hero,.gt-hero__grid{min-height:620px}.gt-hero__copy{padding-top:300px;max-width:100%}.gt-hero__art img{object-position:center 23%}.gt-hero__art:after{background:linear-gradient(0deg,rgba(47,13,24,.97) 0%,rgba(47,13,24,.72) 43%,rgba(47,13,24,.05) 75%)}.gt-hero h1{font-size:45px}.gt-hero__caption{display:none}.gt-section,.gt-products,.gt-story{padding-block:64px}}
  </style>
  <style>
    .gt-hero:before{content:"";position:absolute;width:34vw;height:34vw;max-width:520px;max-height:520px;left:-9vw;top:-10vw;border-radius:50%;background:rgba(245,186,202,.34);filter:blur(38px);animation:gtFloat 10s ease-in-out infinite;z-index:-1}.gt-hero__copy{animation:gtEnter .9s cubic-bezier(.22,.75,.25,1) both}.gt-hero__art img{animation:gtImageIn 1.15s cubic-bezier(.2,.7,.2,1) both}.gt-float-note{position:absolute;z-index:4;left:clamp(20px,4vw,58px);top:105px;display:flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid rgba(255,255,255,.32);background:rgba(255,255,255,.15);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-radius:999px;color:#fff;font:500 10px 'DM Sans',sans-serif;letter-spacing:.05em;box-shadow:0 12px 28px rgba(15,0,6,.14);animation:gtFloat 7s ease-in-out infinite}.gt-float-note i{width:7px;height:7px;background:#f0c8d1;border-radius:50%;box-shadow:0 0 0 4px rgba(240,200,209,.2)}.gt-collection,.gt-product,.gt-match-result{transition:transform .35s cubic-bezier(.22,.75,.25,1),box-shadow .35s ease}.gt-collection:hover,.gt-product:hover{transform:translateY(-7px);box-shadow:0 18px 35px rgba(54,20,30,.12)}.gt-match-result:hover{transform:translateY(-4px);box-shadow:0 18px 35px rgba(54,20,30,.1)}.gt-payment__visual{filter:drop-shadow(0 20px 25px rgba(0,0,0,.16))}.gt-card--front{animation:gtFloat 7s ease-in-out infinite}.gt-card--back{animation:gtFloat 8.5s ease-in-out infinite reverse}.gt-section__head,.gt-story__copy{position:relative}.gt-section__head:after{content:"";position:absolute;width:70px;height:70px;left:0;top:-16px;border-radius:50%;background:rgba(201,116,133,.1);filter:blur(16px);z-index:-1}@keyframes gtFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}@keyframes gtEnter{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}@keyframes gtImageIn{from{opacity:.5;transform:scale(1.045)}to{opacity:1;transform:scale(1)}}@media(max-width:760px){.gt-float-note{top:35px;left:18px;font-size:9px;padding:8px 11px}.gt-collection:hover,.gt-product:hover,.gt-match-result:hover{transform:none}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
  <style>
    .gt-header__inner{position:relative;display:flex;justify-content:space-between}.gt-nav{order:1}.gt-actions{order:3}.gt-brand{position:absolute;z-index:2;top:50%;left:50%;width:88px;height:72px;transform:translate(-50%,-50%);display:grid;place-items:center}.gt-brand img{width:100%;height:100%;object-fit:contain;clip-path:circle(43% at 50% 50%);mix-blend-mode:normal}.gt-hero:before,.gt-float-note{display:none}.gt-hero{background:#421724}.gt-hero__art:after{background:linear-gradient(90deg,rgba(47,13,24,.84) 0%,rgba(58,17,29,.43) 50%,rgba(58,17,29,.08) 100%)}.gt-hero__art img{filter:saturate(.78) contrast(.95) brightness(.95)}.gt-values,.gt-section,.gt-products,.gt-story,.gt-match,.gt-faq{background:#f8f4f1}.gt-products{border-block:1px solid #eee4df}.gt-collection,.gt-collection--blush,.gt-collection--glow,.gt-match-result{background:#f2e8e2}.gt-product__image{background:#fbf9f7}.gt-payment{background:#421724}.gt-payment__methods{background:#f8f4f1}.gt-section__head:after{display:none}@media(max-width:760px){.gt-brand{width:74px;height:62px}.gt-hero__art:after{background:linear-gradient(0deg,rgba(47,13,24,.9) 0%,rgba(47,13,24,.53) 50%,rgba(47,13,24,.06) 80%)}}
  </style>
  <style>.gt-header .gt-brand{display:none}.gt-header__inner{display:flex}.gt-nav{margin-right:0}.gt-actions{margin-left:0}.gt-footer__mark{width:112px;height:112px;margin:0 auto 12px;display:grid;place-items:center;border-radius:50%;background:#fff;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,.14)}.gt-footer img{width:142px;height:142px;object-fit:contain;clip-path:circle(42% at 50% 50%);filter:none}@media(max-width:760px){.gt-footer__mark{width:96px;height:96px}.gt-footer img{width:124px;height:124px}}</style>
</head>
<body>
  <div class="gt-announcement">شحن مجاني للطلبات فوق 299 ر.س <span>✦</span> منتجات نباتية ولم تُجرّب على الحيوانات</div>
  <header class="gt-header" id="top">
    <div class="gt-shell gt-header__inner">
      <button class="gt-icon-btn gt-menu-trigger" type="button" aria-label="فتح القائمة" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      <nav class="gt-nav" aria-label="التنقل الرئيسي">
        <a href="#collections">تسوّقي</a><a href="#bestsellers">الأكثر طلباً</a><a href="#our-story">قصتنا</a>
      </nav>
      <a class="gt-brand" href="#top" aria-label="Glow Theory - الرئيسية"><img src="assets/images/1%20(2).png" alt="Glow Theory"></a>
      <div class="gt-actions">
        <button class="gt-icon-btn" type="button" data-panel="search" aria-label="بحث"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="5.8"/><path d="m16 16 4 4"/></svg></button>
        <button class="gt-icon-btn" type="button" data-panel="account" aria-label="الحساب"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.8-3.4 3.3-5.2 7.5-5.2s6.7 1.8 7.5 5.2"/></svg></button>
        <button class="gt-icon-btn gt-cart-trigger" type="button" aria-label="سلة التسوق"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h2l1.5 10h9.8l1.7-7H7.1"/><circle cx="9" cy="19" r="1"/><circle cx="16.5" cy="19" r="1"/></svg><span class="gt-cart-count">0</span></button>
      </div>
    </div>
  </header>

  <aside class="gt-drawer gt-menu" aria-label="قائمة الموقع" aria-hidden="true">
    <div class="gt-drawer__head"><img src="assets/images/1%20(2).png" alt="Glow Theory"><button class="gt-close" type="button" aria-label="إغلاق">×</button></div>
    <a href="#collections">تسوّقي حسب الفئة</a><a href="#bestsellers">الأكثر طلباً</a><a href="#our-story">عن Glow Theory</a><a href="#faq">الأسئلة الشائعة</a>
  </aside>
  <aside class="gt-drawer gt-cart" aria-label="سلة التسوق" aria-hidden="true">
    <div class="gt-drawer__head"><h2>حقيبتك</h2><button class="gt-close" type="button" aria-label="إغلاق">×</button></div>
    <div class="gt-cart-items"><p class="gt-empty">حقيبتك ما زالت فارغة.</p></div>
    <button class="gt-checkout" type="button">إتمام الطلب <span>←</span></button>
  </aside>
  <div class="gt-popover gt-search" aria-hidden="true"><label for="site-search">ابحثي عن منتجك المفضل</label><div><input id="site-search" type="search" placeholder="مثلاً: محدد شفاه"><button type="button">بحث</button></div><p class="gt-search-result" aria-live="polite"></p></div>
  <div class="gt-popover gt-account" aria-hidden="true"><strong>أهلاً بكِ في Glow Theory</strong><p>سجّلي دخولك لمتابعة طلباتك وحفظ مفضلاتك.</p><button type="button" class="gt-outline">تسجيل الدخول</button></div>
  <div class="gt-overlay"></div>

  <main>{% block content %}{% endblock %}</main>
  <footer class="gt-footer"><div class="gt-shell"><div class="gt-footer__mark"><img src="assets/images/1%20(1).png" alt="Glow Theory"></div><p>الجمال المدروس، بكل بساطة.</p><small>© Glow Theory</small></div></footer>
  <script src="assets/js/main.js?v=4"></script>
</body>
</html>
